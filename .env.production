# Production build (`npm run build:production`) — media from the assets CDN.
# VITE_BASE_URL is the app's mount path. It's set to /maine-labor-mural/ to match
# the review host; CONFIRM/adjust this if the final Maine State Museum site mounts
# the app at a different path (or use / for a dedicated subdomain).
VITE_BASE_URL=/maine-labor-mural/
VITE_IMAGE_BASE=https://assets.digitalgizmo.com/maine-labor-mural

# Online review build (`npm run build:review`) — hosted on digitalgizmo.
# App served under /maine-labor-mural/; media loaded from the assets CDN.
# Media is NOT bundled into dist/ — keep public/ media out of the build so the
# online bundle stays small (it references the CDN instead).
VITE_BASE_URL=/maine-labor-mural/
VITE_IMAGE_BASE=https://assets.digitalgizmo.com/maine-labor-mural

# Review = the KIOSK layout, served online. Identical to build:kiosk except that
# media comes from the CDN above instead of being bundled. (The web layout is
# still built by `npm run build` / `build:production`.)
VITE_KIOSK=true
VITE_KIOSK_IDLE_SECONDS=180

# Offline kiosk build (`npm run build:kiosk`).
# Relative paths so the bundle runs from file:// or any subdirectory with no network.
# Media MUST be present in public/ at build time so it gets bundled into dist/.
VITE_BASE_URL=./
VITE_IMAGE_BASE=.

# Kiosk layout (the 2019 iPad design): set by VITE_KIOSK, read in src/lib/kiosk.js.
VITE_KIOSK=true
# Idle seconds before the attract loop takes over (legacy was 3 minutes). 0 disables.
VITE_KIOSK_IDLE_SECONDS=90
